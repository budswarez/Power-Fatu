rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isGerente() {
      return isAuthenticated() && getRole() in ['gerente', 'admin'];
    }

    // Setup sentinel — publicly readable so /setup page can check without auth
    match /settings/initialized {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /users/{uid} {
      allow get:    if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /channels/{id} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sales/{id} {
      allow read:  if isAuthenticated();
      allow write: if isGerente();
    }

    match /settings/{id} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
