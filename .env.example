# ============================================================
# PFatu — Exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# ============================================================

# ------------------------------------------------------------
# Firebase Client SDK (exposto ao browser — prefixo NEXT_PUBLIC_)
# Encontre em: Firebase Console → Configurações do projeto → Seus apps
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# Firebase Admin SDK (server-side — NUNCA expor ao cliente)
# Encontre em: Firebase Console → Configurações do projeto → Contas de serviço
#              → Gerar nova chave privada (arquivo JSON)
# ------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Chave PEM: cole o conteúdo de "private_key" do JSON com \n literais
# Exemplo: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
